{
  "manifest_version": 3,
  "name": "img2prompt",
  "version": "0.4.2",
  "description": "Paste a screenshot or copy an image, pick an image model, and get a prompt to generate a comparable image.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "img2prompt",
    "default_icon": {
      "16": "icons/16px.png",
      "48": "icons/48px.png",
      "128": "icons/128px.png"
    }
  },
  "icons": {
    "16": "icons/16px.png",
    "48": "icons/48px.png",
    "128": "icons/128px.png"
  },
  "permissions": ["clipboardWrite", "storage"],
  "host_permissions": ["https://autoprompter-backend.onrender.com/*"]
}
